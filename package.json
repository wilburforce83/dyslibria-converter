{
  "name": "dyslibria-converter",
  "version": "0.2.0",
  "description": "Canonical EPUB-to-Dyslibria conversion engine with CLI and Node.js API.",
  "license": "ISC",
  "author": "wilburforce83",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilburforce83/dyslibria-converter.git"
  },
  "bugs": {
    "url": "https://github.com/wilburforce83/dyslibria-converter/issues"
  },
  "homepage": "https://github.com/wilburforce83/dyslibria-converter#readme",
  "keywords": [
    "epub",
    "converter",
    "dyslexia",
    "bionic-reading",
    "cli",
    "node"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "dyslibria-convert": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs --dts --clean --outDir dist && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli/index.ts",
    "qa:pack": "npm pack --dry-run",
    "qa:real-world": "node scripts/run-real-world-regression.mjs",
    "release:check": "npm test && npm run build && npm run qa:pack",
    "prepublishOnly": "npm run release:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "cheerio": "^1.1.2",
    "fs-extra": "^11.2.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
